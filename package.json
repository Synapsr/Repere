{
  "name": "repere",
  "version": "0.1.1",
  "private": true,
  "description": "Open-source visual feedback for websites and PDFs.",
  "homepage": "https://repere.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synapsr/Repere.git"
  },
  "bugs": {
    "url": "https://github.com/Synapsr/Repere/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "node scripts/setup.mjs",
    "test:integration": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:preview": "node scripts/build-preview.mjs",
    "preview:dev": "tsx watch preview/server.ts",
    "preview:start": "tsx preview/server.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.46.0",
    "mysql2": "3.24.4",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "nodemailer": "10.0.10",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "license": "MIT",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
