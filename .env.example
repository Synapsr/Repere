# Generate unique secrets and a working local environment: npm run setup
# Keep this file secret when you copy it to .env. Never commit .env.
APP_PORT=3000
APP_URL=http://localhost:3000
PREVIEW_PORT=3001
# Production requires HTTPS and wildcard preview hostnames, distinct from the app hostname.
PREVIEW_BASE_URL=http://localhost:3001
# Used by a local Next process; Compose overrides this with http://preview:3001.
PROXY_INTERNAL_URL=http://127.0.0.1:3001
PROXY_SECRET=replace-with-independent-at-least-32-random-bytes
MYSQL_PORT=3308
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-different-random-hex
# Used by local Next / Drizzle; Compose points its services to the internal db host.
DATABASE_URL=mysql://repere:replace-with-random-hex@127.0.0.1:3308/repere
SESSION_SECRET=replace-with-at-least-32-random-bytes
UPLOAD_DIR=./uploads

# Local development: captured by Mailpit. Production: supply your actual SMTP service.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Repere <hello@repere.local>
SMTP_SECURE=false
MAILPIT_PORT=8026
MAILPIT_SMTP_PORT=1026
MAILPIT_URL=http://127.0.0.1:8026

# Optional restrictions for creating projects; shared-link reviewers remain welcome.
ALLOWED_EMAIL_DOMAINS=
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
PREVIEW_MAX_SESSIONS=100
PREVIEW_SESSION_TTL_MS=3600000
PREVIEW_MAX_HTML_BYTES=8388608
# Development only: exact hosts reachable by a proxy running on your machine.
PREVIEW_ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1
# Full Docker tests use the Compose network name; a local proxy uses localhost instead.
E2E_WEBSITE_URL=http://app:3000/demo-site
